{
  "name": "BEIRUT — Pedidos Web",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "beirut-pedidos",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "a1b2c3d4-0000-4000-8000-000000000001",
      "name": "Webhook Pedido",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "beirut-pedidos"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f1",
              "name": "mensaje",
              "value": "=🛒 *NUEVO PEDIDO WEB #{{ $json.body.orderNumber }}*\n\n*Cliente:* {{ $json.body.customer.name }} ({{ $json.body.customer.phone }})\n*Entrega:* {{ $json.body.delivery.method === 'domicilio' ? 'Domicilio — ' + ($json.body.delivery.address || '') + ', ' + ($json.body.delivery.city || '') : 'Recogida en tienda' }}\n*Pago:* {{ $json.body.paymentMethod }} ({{ $json.body.paymentStatus }}){{ $json.body.wompiTransactionId ? '\\n*Tx Wompi:* ' + $json.body.wompiTransactionId : '' }}\n\n*Productos:*\n{{ $json.body.lines.map(l => '• ' + l.quantity + ' x ' + l.name + ' — ' + l.lineTotal).join('\\n') }}\n\n*Total:* ${{ $json.body.total }} COP"
            },
            { "id": "f2", "name": "telefono", "value": "={{ $json.body.customer.phone }}" },
            { "id": "f3", "name": "orderNumber", "value": "={{ $json.body.orderNumber }}" }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0000-4000-8000-000000000002",
      "name": "Formatear Mensaje",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "operation": "send",
        "recipientPhoneNumber": "573128527325",
        "text": "={{ $json.mensaje }}"
      },
      "id": "a1b2c3d4-0000-4000-8000-000000000003",
      "name": "Notificar por WhatsApp",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [680, 300],
      "credentials": {
        "whatsAppApi": {
          "id": "REEMPLAZAR",
          "name": "WhatsApp Cloud API (Meta)"
        }
      }
    }
  ],
  "connections": {
    "Webhook Pedido": {
      "main": [[{ "node": "Formatear Mensaje", "type": "main", "index": 0 }]]
    },
    "Formatear Mensaje": {
      "main": [[{ "node": "Notificar por WhatsApp", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {},
  "active": false
}
