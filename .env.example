# Llave pública de Wompi. En sandbox usa una llave pub_test_...
REACT_APP_WOMPI_PUBLIC_KEY=pub_stagtest_xxxxxxxxxxxxxxxxxxxx

# ⚠️ SEGURIDAD: NUNCA agregues aquí el "secreto de integridad" de Wompi ni
# ninguna otra clave privada. Todo lo que esté en este archivo viaja al
# navegador de los visitantes. La firma de integridad (si la activas en
# Wompi) debe generarse en el SERVIDOR (n8n / edge function), nunca aquí.

# Webhook de n8n (o cualquier backend) que recibe cada pedido en JSON.
# Ejemplo: https://tu-n8n.com/webhook/beirut-pedidos
# Si se deja vacío, el pedido solo se envía por WhatsApp como hasta ahora.
REACT_APP_ORDER_WEBHOOK_URL=

# Supabase (Dashboard → Project Settings → API)
# Si se dejan vacíos, la app usa el catálogo estático y pedidos en localStorage.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
