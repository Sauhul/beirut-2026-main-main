# Llave pública de Wompi. En sandbox usa una llave pub_test_...
REACT_APP_WOMPI_PUBLIC_KEY=

# ⚠️ SEGURIDAD: NUNCA agregues aquí el "secreto de integridad" de Wompi ni
# ninguna otra clave privada con el prefijo REACT_APP_.

# Clave de Resend para /api/send-email (solo servidor)
RESEND_API_KEY=

# Supabase (Dashboard → Project Settings → API)
# Usa una clave publishable o anon. Sin estos valores, solo se muestra el catálogo de respaldo.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
